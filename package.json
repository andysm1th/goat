{
  "name": "pretext-goat",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./lib/types/element/index.d.ts",
      "import": "./lib/text-goat.js"
    },
    "./react": {
      "types": "./lib/types/react/index.d.ts",
      "import": "./lib/react.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build -c vite.lib.config.ts --mode site",
    "preview": "vite preview --host 127.0.0.1",
    "convert": "node scripts/convert.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "techno-loop": "node scripts/make-techno-loop.mjs",
    "perf": "node --expose-gc scripts/audit-performance.mjs",
    "build:lib": "vite build -c vite.lib.config.ts --mode element && vite build -c vite.lib.config.ts --mode react && tsc -p tsconfig.lib.json && node -e \"require('node:fs').cpSync('public/animation','lib/animation',{recursive:true})\""
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
